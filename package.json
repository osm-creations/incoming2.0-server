    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/node": "^22.15.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261118.0-beta",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  },
  "packageManager": "npm@10.9.2"
}
